{
  "globs": ["content/docs/**/*.mdx", "README.md"],
  "config": {
    // Prose isn't hard-wrapped.
    "MD013": false,
    // Fumadocs components used in MDX pages.
    "MD033": { "allowed_elements": ["Callout", "Card", "Cards"] },
    // Frontmatter supplies the page title, so pages don't start with a heading.
    "MD041": false
  }
}
